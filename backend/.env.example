# 12-factor environment template for the backend service.
# Copy to `.env` for local use. NEVER commit a real `.env` or any secret.
# Values below are non-secret placeholders wired for the dev profile.

# SQLAlchemy 2.0 + psycopg 3 sync DSN (consumed via pydantic-settings in Story 1.2).
DATABASE_URL=postgresql+psycopg://todo:todo@localhost:5432/todo

# Comma-separated CORS origins. CORS middleware is added ONLY when this is
# non-empty (see app/main.py) — it is set on the `backend-dev` service in the
# dev compose profile so the cross-origin Vite dev server (:5173) can call the
# backend, and left UNSET in the prod single-origin stack (AD-10, no CORS).
CORS_ORIGINS=http://localhost:5173

# Log level for structured JSON stdout logging.
LOG_LEVEL=info

# Test-only: DSN the integration suite (tests/integration/conftest.py) connects
# to. Defaults to the compose `test`-profile ephemeral Postgres on host :5433.
# Set to ...@db-test:5432/... when running the suite in-container (backend-test).
TEST_DATABASE_URL=postgresql+psycopg://todo:todo@localhost:5433/todo
