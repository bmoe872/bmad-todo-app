# Build-time frontend configuration (Vite exposes only VITE_-prefixed vars).
# Copy to `.env` for local use. No secrets in v1.

# Base URL for the backend REST API. In the composed single-origin stack this is
# same-origin ("/api"); in dev the Vite server calls the backend directly.
VITE_API_BASE_URL=http://localhost:8000/api

# Dev-server only: poll the filesystem for changes so HMR fires over a Docker
# bind mount (Docker Desktop doesn't deliver native inotify events reliably).
# Consumed by vite.config.ts. Leave unset (or !=1) for a plain local dev server.
VITE_DEV_POLLING=1
