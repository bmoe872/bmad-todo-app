# 12-factor configuration for the composed stack (docker-compose.yml).
# Copy to `.env` for local overrides. `.env` is gitignored — NEVER commit real
# values. Everything here has a non-secret default baked into the compose file
# via `${VAR:-default}`, so the stack runs with NONE of these set; this file
# just documents the knobs. No secrets exist in v1.

# ---- Database (db / db-test) ----
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo
POSTGRES_DB=todo

# ---- Host port mappings ----
# Prod-like stack (default `docker compose up`):
FRONTEND_PORT=8080          # public app origin (nginx, single-origin) → host
BACKEND_PORT=8000           # backend debug port (browser does NOT use this)
# dev profile (`--profile dev`):
FRONTEND_DEV_PORT=5173      # Vite dev server (HMR) → host
# test profile (`--profile test`):
TEST_DB_PORT=5433           # ephemeral test Postgres → host (matches conftest)

# ---- Backend config ----
LOG_LEVEL=info              # structured JSON stdout log level
# CORS is enabled ONLY in the dev profile (AD-10). Prod is single-origin and
# leaves this UNSET (no CORS). This value is applied to `backend-dev` so the
# cross-origin Vite dev server can call the backend.
CORS_ORIGINS=http://localhost:5173

# ---- Frontend (dev profile) ----
# Where the browser (at :5173) reaches the backend in dev (cross-origin). In the
# prod build this is unset and the SPA uses the same-origin "/api" nginx proxy.
VITE_API_BASE_URL=http://localhost:8000/api
# Poll for file changes so HMR works over the bind mount on Docker Desktop.
VITE_DEV_POLLING=1
